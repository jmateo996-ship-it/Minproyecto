{
  "name": "exodo-2942",
  "version": "1.0.0",
  "private": true,
  "description": "Éxodo 2942: shoot'em up vertical futurista para iOS y Android",
  "scripts": {
    "start": "npx http-server www -p 8080 -c-1",
    "assets": "node tools/make-store-assets.js && npx @capacitor/assets generate --iconBackgroundColor '#05030f' --splashBackgroundColor '#05030f'",
    "cap:add": "npx cap add ios && npx cap add android",
    "sync": "npx cap sync",
    "ios": "npx cap sync ios && npx cap open ios",
    "android": "npx cap sync android && npx cap open android",
    "build:single": "python3 tools/build_single.py && python3 tools/build_single.py --test",
    "i18n:missing": "python3 tools/i18n.py extract en"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/ios": "^6.1.2",
    "@capacitor/haptics": "^6.0.0",
    "cordova-plugin-purchase": "^13.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2"
  }
}
